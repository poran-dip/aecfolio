{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**", "vitest.config.ts"]
    },
    "@aecfolio/api#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**", "vitest.config.ts"],
      "passThroughEnv": [
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "ALLOW_UNSAFE_TEST_DB",
        "S3_*",
        "TEST_S3_BUCKET"
      ]
    },
    "@aecfolio/web#test": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["app/**", "vitest.config.ts"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "cache": false
    },
    "lint": {
      "cache": true
    }
  }
}
