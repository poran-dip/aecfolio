# ─────────────────────────────────────────────────────────────────────────────
# AECFolio — one environment file for the whole monorepo.
#
#   cp .env.example .env
#
# There is deliberately only this file. Every dev/start script runs through
# `dotenv-run`, which walks up from any workspace directory and finds it, so
# there is nothing per-app to keep in sync.
#
# Containers never read a .env file: docker-compose.yml passes what each
# service needs as real environment variables.
#
# Every variable below is read by `packages/config`, which validates it lazily
# and per-scope. A missing or malformed value fails at startup with a message
# naming the variable — not at the first request.
#
# The defaults here are the working local loop:
#   docker compose -f compose.dev.yml up -d    # Postgres on :55432
#   pnpm db:migrate
#   pnpm dev                                   # web :3000  api :3002  worker :3001
# ─────────────────────────────────────────────────────────────────────────────


# ── Postgres container ───────────────────────────────────────────────────────
# Read by docker-compose only (both the dev and the production stack).
POSTGRES_USER=aecfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aecfolio


# ── Database ─────────────────────────────────────────────────────────────────
# Read by packages/db, drizzle-kit and scripts/bootstrap.ts.
# Port 55432, not 5432: a locally-installed Postgres already owns 5432, and a
# silently shadowed mapping is worse than an unusual port number.
DATABASE_URL=postgresql://aecfolio:change-me@localhost:55432/aecfolio


# ── Auth ─────────────────────────────────────────────────────────────────────
# Read by apps/api.
# BETTER_AUTH_URL is the origin of the *API*. Its counterpart CORS_ORIGIN below
# is the origin of the *web app*. Swapping the two is the single most common
# way to break a first deployment.
BETTER_AUTH_URL=http://localhost:3002
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client (Web application). Authorised redirect URI:
#   http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3002
# Origin of the WEB app. Feeds the CORS allowlist and better-auth trustedOrigins.
CORS_ORIGIN=http://localhost:3000
WORKER_URL=http://localhost:3001


# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_PORT=3001
# Only set this where a system Chromium is installed (the Docker image does).
# Leave it unset locally to use the Chromium puppeteer downloaded on install.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium


# ── Web ──────────────────────────────────────────────────────────────────────
# Origin the BROWSER uses to reach the API. Injected into the page at runtime
# by the root loader — it is not a build-time constant, so the same image works
# in any environment. Must be an origin with NO /api suffix: every call site
# appends its own /api/... path, and `packages/config` rejects a trailing /api.
PUBLIC_API_URL=http://localhost:3002
# Origin the SSR server uses to reach the API. In compose this is http://api:3002.
INTERNAL_API_URL=http://localhost:3002
# The dev server port is pinned in apps/web/vite.config.ts; in production
# react-router-serve reads PORT, which docker-compose.yml sets.


# ── Production stack only ────────────────────────────────────────────────────
# Read by docker-compose.yml. The single public origin nginx serves — it becomes
# the API origin, the web origin, and the browser's API origin all at once,
# because nginx proxies /api/ to the API and everything else to the SSR server.
# Change this one value to deploy to a real domain.
PUBLIC_ORIGIN=http://localhost


# ── Not yet used ─────────────────────────────────────────────────────────────
# S3_* / MinIO credentials arrive with the file-storage work (C03 + U03) and
# DIRECT_URL was left over from a pooled-connection setup. Both were removed
# rather than left here to be filled in for no effect (M04).
