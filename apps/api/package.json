{
  "name": "@aecfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv-run -- tsx watch src/index.ts",
    "build": "tsdown",
    "start": "dotenv-run -- node dist/index.js",
    "typecheck": "tsc",
    "test": "dotenv-run -- vitest run",
    "test:watch": "dotenv-run -- vitest"
  },
  "dependencies": {
    "@aecfolio/config": "workspace:*",
    "@aecfolio/db": "workspace:*",
    "@aecfolio/shared": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@dotenv-run/cli": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "^0.9.1",
    "@paralleldrive/cuid2": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
