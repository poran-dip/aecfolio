{
  "name": "@aecfolio/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm build:css && tsdown",
    "build:css": "tsx scripts/build-css.ts",
    "preview": "tsx scripts/preview.ts",
    "test": "pnpm build:css && vitest run",
    "typecheck": "pnpm build:css && tsc"
  },
  "dependencies": {
    "@aecfolio/shared": "workspace:*",
    "react": "catalog:",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./manifests": {
      "types": "./dist/manifests.d.mts",
      "import": "./dist/manifests.mjs"
    },
    "./icons": {
      "types": "./dist/icons.d.mts",
      "import": "./dist/icons.mjs"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.mts",
      "import": "./dist/fixtures.mjs"
    },
    "./styles/app.css": "./src/styles/app.css",
    "./styles/tokens.css": "./src/styles/palette.css",
    "./cv.css": "./dist/cv.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src/styles"
  ]
}
