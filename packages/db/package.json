{
  "name": "@aecfolio/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "generate": "dotenv-run -- drizzle-kit generate --config drizzle.config.ts",
    "migrate": "dotenv-run -- drizzle-kit migrate --config drizzle.config.ts",
    "push": "dotenv-run -- drizzle-kit push",
    "studio": "dotenv-run -- drizzle-kit studio",
    "seed": "dotenv-run -- tsx src/seed.ts",
    "seed:fake": "dotenv-run -- tsx src/seed-fake.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@aecfolio/config": "workspace:*",
    "@dotenv-run/cli": "catalog:",
    "@paralleldrive/cuid2": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
